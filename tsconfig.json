{
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "./dist",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2024",
    "allowJs": false,
    "removeComments": true,
    "allowUnreachableCode": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "strict": false,
    "skipLibCheck": true,
    "paths": {
      "@ta-x-features": ["./src/features/index"],
      "@ta-x-features/*": ["./src/features/*"],
      "@ta-x-partials/*": ["./src/views/partials/*"],
      "@ta-x-globals": ["./src/globals/index"],
      "@ta-x-utilities": ["./src/utilities/index"],
      "@ta-x-utilities/*": ["./src/utilities/*"],
      "@ta-x-models": ["./src/models/index"],
      "@ta-x-components": ["./src/components/index"],
      "@ta-x-helpers": ["./src/helpers/index"],
      "@ta-x-build-helpers": ["./build/helpers/index"],
      "@ta-x-types": ["./src/types/index"],
      "@ta-x-scss/*": ["./src/scss/*"],
      "@ta-x-tinymce-scss/*": [
        "./src/scss/features/staff-walkthrough-improvements/tinymce/*"
      ],
      "@ta-x-views/*": ["./src/views/*"],
      "@ta-x-svgs/*": ["./src/resources/svgs/*"],
      "@ta-x-project-root/*": ["./*"],
      "@ta-x-test": ["./test/index"],
      "@ta-x-test-views/*": ["./test/html/*"]
    }
  },
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.test.json" }
  ]
}