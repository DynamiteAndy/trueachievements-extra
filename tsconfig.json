{
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2024",
    "allowJs": false,
    "allowUnreachableCode": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "allowImportingTsExtensions": true,
    "types": ["vitest/globals", "node", "tampermonkey"],
    "paths": {
      "@ta-x-page": ["./src/page/index"],
      "@ta-x-fetch": ["./src/fetch/index"],
      "@ta-x-storage": ["./src/storage/index"],
      "@ta-x-site": ["./src/site/index"],
      "@ta-x-lib": ["./src/lib/index"],
      "@ta-x-features": ["./src/features/index"],
      "@ta-x-ui": ["./src/ui/index"],
      "@ta-x-scss/*": ["./src/scss/*"],
      "@ta-x-project-root/*": ["./*"],
      "@ta-x-test": ["./test/index"],
      "@ta-x-test-timers": ["./test/support/timers"],
      "@ta-x-test-views/*": ["./test/html/*"]
    }
  },
  "include": ["src/**/*", "test/**/*", "build/**/*", "vitest.*.mts", "package.json"],
  "exclude": ["dist", "node_modules"]
}