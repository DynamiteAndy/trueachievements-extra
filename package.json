{
  "name": "trueachievements-extras",
  "version": "4.0.0",
  "type": "module",
  "engines": {
    "node": ">=26.13.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error",
      "version": "12.23.0"
    }
  },
  "private": true,
  "description": "Provides a variety of extras for use on TrueAchievements",
  "bugs": {
    "url": "https://github.com/dynamiteandy/trueachievements-extra/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dynamiteandy/trueachievements-extra.git"
  },
  "author": "Dynamite Andy - dynamiteandy@gmail.com",
  "scripts": {
    "prepare": "husky",
    "postinstall": "node build/link-editor-tsdk.ts",
    "analyse": "rspack build --config ./build/rspack.prod.conf.ts --config-name prod-min --env analyse",
    "analyse:snapshot": "node build/rsdoctor-snapshot.ts",
    "analyse:diff": "rsdoctor bundle-diff --baseline=dist/local/rsdoctor-before/manifest.json --current=dist/local/rsdoctor-after/manifest.json --html --output=dist/local/rsdoctor-diff.html",
    "build": "pnpm run build:dev && pnpm run build:prod-all",
    "build:release": "rspack build --config ./build/rspack.prod.conf.ts --env release",
    "build:dev": "rspack build --config ./build/rspack.dev.conf.ts",
    "build:prod": "rspack build --config ./build/rspack.prod.conf.ts --config-name prod",
    "build:prod-min": "rspack build --config ./build/rspack.prod.conf.ts --config-name prod-min",
    "build:prod-all": "rspack build --config ./build/rspack.prod.conf.ts",
    "lint": "oxfmt --check \"src/**/*.{ts,tsx,scss}\" \"test/**/*.{ts,tsx}\" \"build/**/*.ts\" \"*.mts\" && oxlint --deny-warnings",
    "fix": "oxfmt --write \"src/**/*.{ts,tsx,scss}\" \"test/**/*.{ts,tsx}\" \"build/**/*.ts\" \"*.mts\" && oxlint --fix",
    "start": "rspack build --config ./build/rspack.dev.conf.ts --watch",
    "test:reports": "vitest --config vitest.reports.config.mts --ui",
    "test:github": "vitest run --coverage.enabled --coverage.reporter=lcov --reporter=default --reporter=github-actions --reporter=junit --outputFile.junit=dist/coverage/test-report.junit.xml",
    "test:mutate": "node test/tools/mutate/prove.ts",
    "fixture:condense": "node test/tools/fixtures/condense-cli.ts"
  },
  "devDependencies": {
    "@preact/signals-debug": "^1.5.0",
    "@rsdoctor/cli": "^2.0.4",
    "@rsdoctor/core": "^2.0.4",
    "@rspack/cli": "^2.3.4",
    "@rspack/core": "^2.3.4",
    "@types/node": "^26.6.11",
    "@types/sanitize-html": "^2.16.2",
    "@types/tampermonkey": "^5.5.0",
    "@vitest/coverage-v8": "^5.1.2",
    "@vitest/ui": "^5.1.2",
    "emoji.json": "^16.0.0",
    "fake-indexeddb": "^6.2.8",
    "happy-dom": "^21.0.4",
    "htmlnano": "^3.7.0",
    "husky": "^9.1.7",
    "lightningcss": "^1.33.0",
    "marked": "^18.3.0",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "preact-render-to-string": "^6.8.3",
    "rspack-merge": "^1.0.1",
    "sanitize-html": "^2.18.2",
    "sass": "^1.108.2",
    "sass-loader": "^17.1.1",
    "tsrs": "7.1.0-beta.tsrs5",
    "vitest": "^5.1.2",
    "yaml": "^2.9.1"
  },
  "url": "https://github.com/dynamiteandy/trueachievements-extra",
  "dependencies": {
    "@eastdesire/jscolor": "^2.5.2",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@preact/signals": "^2.11.4",
    "@rxliuli/vista": "^0.5.3",
    "compress-json": "^3.4.0",
    "preact": "^11.2.0"
  },
  "packageManager": "pnpm@12.23.0"
}
