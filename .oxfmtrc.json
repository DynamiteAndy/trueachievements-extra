{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 120,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "none",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "singleAttributePerLine": false,
  "ignorePatterns": ["dist/**", "node_modules/**", "coverage/**", "test/html/**/*.html"],
  "overrides": [
    {
      "files": ["*.hbs"],
      "options": { "singleQuote": false }
    },
    {
      "files": ["*.ts"],
      "options": { "printWidth": 120 }
    }
  ]
}
