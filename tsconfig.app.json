{
  "extends": "./tsconfig",
  "compilerOptions": {
    "composite":true,
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": true,
    "types": ["happy-dom", "node", "sanitize-html", "tampermonkey"]
  },
  "include": ["**/*.ts", "package.json", "tsconfig.json"],
  "exclude": ["src/**/*.spec.ts", "test/**/*.ts", "vitest.*.mts", "dist"]
}
