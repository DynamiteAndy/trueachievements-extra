{{parseProperty "tabs" '[
  {"id": "miscellaneous-improvements", "label": "Misc Improvements", "selected": true},
  {"id": "forum-improvements", "label": "Forum Improvements"},
  {"id": "gamer-improvements", "label": "Gamer Improvements"},
  {"id": "games-improvements", "label": "Games Improvements"},
  {"id": "news-improvements", "label": "News Improvements"},
  {"id": "staff-walkthrough-improvements", "label": "Staff Walkthrough Improvements"}
]'}}

<div class="js-ta-x-settings-menu-wrench gamer-page" role="button" aria-haspopup="true" aria-label="Open Settings">
  <i class="fa fa-wrench" aria-hidden="true"></i>
</div>

<div class="js-ta-x-settings-menu js-ta-x-tabs ta-x-settings-menu ta-x-hide" role="dialog" aria-modal="true">
  <div class="middle">
    <div class="wrap">
      <div class="labels">
        <ul class="tabs-nav ta-x-tabs-link-container js-ta-x-tabs-link-container" role="tablist">
          {{#each tabs}}
            <li
              class="js-ta-x-tabs-link ta-x-tabs-link {{conditional ta-x-tabs-selected=this.selected}}"
              data-tab-id="#ta-x-tabs-{{this.id}}"
              role="tab"
              aria-selected="{{ternary this.selected 'true' 'false'}}"
            >
              {{this.label}}
            </li>
          {{/each}}
        </ul>

        <label class="js-ta-x-settings-menu-close close" aria-label="Close Settings">
          <i class="fa fa-close" aria-hidden="true"></i>
        </label>
      </div>

      <div class="contents">
        {{#each tabs}}
          <div
            id="ta-x-tabs-{{this.id}}"
            class="js-ta-x-tabs-content ta-x-tabs-content t-settings"
            {{#if this.selected}}data-tab-visible{{/if}}
            role="tabpanel"
          >
            {{includes (string "@ta-x-features/" this.id "/settings.hbs")}}
          </div>
        {{/each}}

        <div
          id="ta-x-tabs-changelog-credits"
          class="js-ta-x-settings-menu-changelog js-ta-x-tabs-content ta-x-tabs-content t-settings"
          role="tabpanel"
        >
          {{changelog (markdown "@ta-x-project-root/CHANGELOG.md" false "ta-x-settings-menu-changelog-wrapper")}}
          {{markdown "@ta-x-project-root/CREDITS.md" true "ta-x-settings-menu-credits-wrapper"}}
        </div>

        <div
          id="ta-x-tabs-feature-documentation"
          class="js-ta-x-settings-menu-feature-documentation js-ta-x-tabs-content ta-x-tabs-content t-settings"
          role="tabpanel"
        >
          {{markdown "@ta-x-project-root/FEATURE-DOCUMENTATION.md" true "ta-x-settings-menu-documentation-wrapper"}}
        </div>

        <div class="t-settings open ta-x-settings-menu-bottom">
          <ul class="list-links buttons">
            <li>
              <a
                href="https://github.com/dynamiteandy/trueachievements-extra/issues/new"
                target="_blank"
                rel="noopener noreferrer"
              >
                Raise a Bug
              </a>
            </li>
            <li>
              <a
                href="https://github.com/dynamiteandy/trueachievements-extra/issues/new"
                target="_blank"
                rel="noopener noreferrer"
              >
                Request a Feature
              </a>
            </li>
          </ul>

          <div class="title">
            <span>TrueAchievements Extra</span>
            <div class="ta-x-flex-break"></div>
            <a href="#" class="js-ta-x-settings-menu-version">
              Version {GM_info.script.version}
            </a>
            <span>|</span>
            <a href="#" class="js-ta-x-settings-menu-documentation">
              Feature Documentation
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="js-ta-x-settings-menu-close close" aria-hidden="true"></div>
</div>