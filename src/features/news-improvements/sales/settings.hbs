{{parseProperty "salesSortByOptions" '[
  { "value": "product,game", "text": "Product", "selected": true },
  { "value": "sale-price", "text": "Sale Price" },
  { "value": "discount", "text": "Discount" },
  { "value": "completion-time", "text": "Completion Time" },
  { "value": "ta-ratio", "text": "TA Ratio" }
]'}}

{{parseProperty "salesSortOrderOptions" '[
  { "value": "asc", "text": "Ascending", "selected": true },
  { "value": "desc", "text": "Descending" }
]'}}

{{#includes
  "@ta-x-partials/accordion.hbs"
  title="Sales"
  expanded=false
  accordion-target=".js-ta-x-settings-news-improvements-sales"
  accordion-header-classes="labels"
  accordion-content-classes="js-ta-x-settings-news-improvements-sales t-settings"
}}
  {{includes
    "@ta-x-partials/checkbox-setting.hbs"
    label="Sort Sales By"
    id="chkNewsImprovementsSalesAutoSortBy"
    config-path="newsImprovements.sales.autoSortBy"
    classes="ta-x-hide-border-when-checked"
  }}

  {{includes
    "@ta-x-partials/select-setting.hbs"
    id="selNewsImprovementsSalesAutoSortByValue"
    config-path="newsImprovements.sales.autoSortByValue"
    render-condition='{"selector":"#chkNewsImprovementsSalesAutoSortBy","checked":true}'
    container-classes="ta-x-hide-padding-top ta-x-hide-border"
    helper-text="This option may not work on some tables. Let me know what you spot!"
    helper-render-condition='{"selector":"#selNewsImprovementsSalesAutoSortByValue","value":"completion-time,ta-ratio"}'
    is-array="true"
    array-split=","
    options=salesSortByOptions
  }}

  {{includes
    "@ta-x-partials/select-setting.hbs"
    id="selNewsImprovementsSalesAutoSortByOrder"
    config-path="newsImprovements.sales.autoSortByOrder"
    render-condition='{"selector":"#chkNewsImprovementsSalesAutoSortBy","checked":true}'
    container-classes="ta-x-hide-padding-top"
    options=salesSortOrderOptions
  }}

  {{includes
    "@ta-x-partials/checkbox-setting.hbs"
    label="Hide Owned Items"
    id="chkNewsImprovementsSalesHideOwnedItems"
    config-path="newsImprovements.sales.hideOwnedItems"
  }}

  {{includes
    "@ta-x-partials/checkbox-setting.hbs"
    label="Hide Unobtainable Items"
    id="chkNewsImprovementsSalesHideUnobtainableItems"
    config-path="newsImprovements.sales.hideUnobtainableItems"
  }}

  {{includes
    "@ta-x-partials/checkbox-setting.hbs"
    label="Collapsible Groups"
    id="chkNewsImprovementsSalesCollapsibleGroups"
    config-path="newsImprovements.sales.collapsibleGroups"
  }}
{{/includes}}