<div
  class="ta-x-accordion js-ta-x-accordion collapsed {{accordion-header-classes}} {{conditional expanded=expanded}}"
  data-accordion-target="{{accordion-target}}"
>
  <span>{{title}}</span>
  {{includes "@ta-x-svgs/chevron-down.hbs"}}
</div>

<div
  class="ta-x-accordion-content js-ta-x-accordion-content {{accordion-content-classes}}"
  style="max-height: {{ternary expanded '100%' '0px'}};"
>
  {{{partialContent}}}
</div>