<div
  data-render-condition="{{render-condition}}"
  class="ta-x-checkbox {{conditional ta-x-hide=render-condition}} {{classes}}"
  style="{{style}}"
>
  <label for="{{ternary id id name}}">
    {{label}}
  </label>

  <div class="frm-grp frm-tgl">
    <input
      type="checkbox"
      id="{{ternary id id name}}"
      name="{{ternary name name id}}"
      data-config-path="{{config-path}}"
      {{#if checked}}checked{{/if}}
    />
    <label for="{{ternary id id name}}"></label>
  </div>

  {{#if helper-text}}
    <p
      data-render-condition="{{helper-render-condition}}"
      class="ta-x-settings-helper-text {{conditional ta-x-hide=helper-render-condition}}"
    >
      {{helper-text}}
    </p>
  {{/if}}
</div>