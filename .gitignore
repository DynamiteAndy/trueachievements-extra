# Windows
Thumbs.db
ehthumbs.db

# Editors and stray files
.vs
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
*.orig
*.tmp
*.log
*~

# Dependencies
node_modules/

# Builds: only the release scripts in dist/ are tracked (CI commits them; the skill's build-and-ci.md). Everything
# else there is ignored: the local builds, Vitest's coverage and JUnit reports (dist/coverage/), its bench baselines
# (dist/test-results/, writing-specs.md) and each review's folder (dist/refactoring-lanes/, repo-review)
dist/*

# Vitest (its attachments in .vitest/, and the config's temporary copies)
.vitest/
vitest.config.mts.timestamp-*

# Git Bash crash dumps
*.stackdump

# The project skill's per-developer notes (account and machine; local.example.md is the template)
.claude/skills/trueachievements-extra/local.md

# Claude Code: each developer's own permissions and settings (the shared ones are .claude/settings.json)
.claude/settings.local.json

# Work in progress within and across sessions (open-items.md holds what carries over)
/refactoring.md
