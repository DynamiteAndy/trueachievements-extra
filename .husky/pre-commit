# Only CI writes the release scripts in dist/, so a commit never takes dist changes: changes to files HEAD has are
# put back, and new files are only unstaged
staged_dist=$(git diff --cached --name-only -- dist)
if [ -n "$staged_dist" ]; then
  echo "Unstaging files in the 'dist' directory before commit:"
  echo "$staged_dist"
  git diff --cached --name-only --no-renames --diff-filter=MD -z -- dist |
    xargs -0 -r git restore --source=HEAD --staged --worktree --
  git restore --staged -- dist
fi

pnpm run lint
